{
  "timezone": "America/Sao_Paulo",
  "collector": {
    "base_url": "https://copa.jarg.top/api/save-agenda?dedup=true",
    "api_key_env": "FIXTURE_COLLECTOR_API_KEY",
    "timeout_seconds": 30
  },
  "api_football": {
    "api_key_env": "API_FOOTBALL_KEY",
    "teams_endpoint": "https://v3.football.api-sports.io/teams",
    "timeout_seconds": 30,
    "required": true
  },
  "text": {
    "provider_id": "current-task",
    "primary_model_id": "current-task",
    "fallback_model_id": "current-task"
  },
  "image": {
    "model_id": "gpt-image-2",
    "size": "1024x1280",
    "primary": {
      "provider_id": "active-large-model-api",
      "base_url": "https://crs.whynotm.abrdns.com",
      "base_url_env": "PRIMARY_IMAGE_BASE_URL",
      "api_key_env": "PRIMARY_IMAGE_API_KEY",
      "credential_json": {"path": "~/.codex/auth.json", "field": "OPENAI_API_KEY"}
    },
    "fallback": {
      "provider_id": "apimart",
      "base_url": "https://api.apimart.ai/v1",
      "base_url_env": "APIMART_IMAGE_BASE_URL",
      "api_key_env": "APIMART_API_KEY",
      "keychain_service": "APIMART_API_KEY"
    }
  },
  "poster": {
    "canvas": "2048x2560",
    "delivery_dir": "deliveries",
    "styles": ["fan_crowd", "star_faceoff"]
  }
}
